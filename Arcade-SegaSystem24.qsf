# Sega System 24 for MiSTer. Add HDL to files.qip, not through the GUI.
set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
# SEED 2, not 4 or 1. History:
#  - Widening the sprite descriptor caches (rtl/video/s24_sprite.sv,
#    tile_base/palette_base carried through instead of zero-filled) turned a
#    synthesis-collapsed constant-zero adder operand into a genuine live one
#    on the sprite line-RAM write-enable cone, costing ~0.8ns on clk_sys and,
#    via placement pressure from the wider RAMs, opening a small clk_ram
#    hold violation on cdc_wr:req_hold->dst_payload (the write-port CDC).
#    Seed 4 could not close either at STANDARD FIT/MAXIMUM router effort with
#    both physical-synthesis options ON; seed 1 closed both.
#  - Removing rtl/mem/sdram.sv's ST_RD_GAP (restoring back-to-back BURST_1
#    READ issuance -- see that file for why) changed sdram.sv's placement
#    footprint enough to reopen the SAME cdc_wr hold path under seed 1
#    (worst -0.187ns, all 4 corners). Seed 2 closes it again (worst
#    +0.098ns Fast -40C) while keeping clk_sys setup (>=+0.474ns) and
#    clk_ram setup (>=+0.152ns) positive at all 4 corners, and does not
#    disturb SDRAM_CLK or the clk_ram/SDRAM_DQ->dq_in timing fixed by the
#    SDC multicycle below.
# Any future change to rtl/mem/sdram.sv or the sprite descriptor RAMs'
# width/shape should re-verify cdc_wr:req_hold->dst_payload hold margin
# before assuming this seed still closes it.
set_global_assignment -name SEED 2

# Machine-wide safe Quartus policy. Do not override these in build scripts.
#
# Release-build exception (deliberate, approved): the four settings below were
# raised from the light-load development policy because the design is at 86%
# ALM / 86% RAM and the router reported "an exceedingly large amount of
# congestion" under FAST FIT, leaving hold violations on the s24_sdram_cdc
# payload paths. FAST FIT stops optimising early by design; it is the correct
# default for iterating, not for producing a deployable RBF. Cost is compile
# time and CPU load only -- none of these change hardware behaviour.
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL MAXIMUM
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name COMPRESSION_MODE ON

set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE OFF
set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"
set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"
set_global_assignment -name VERILOG_MACRO "SYNTHESIS"

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
