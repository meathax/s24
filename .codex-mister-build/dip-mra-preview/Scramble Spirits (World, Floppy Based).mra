  <rotation>vertical (ccw)</rotation>
  <joystick>8-way</joystick>
  <buttons default="A,B,Start,Select,R,L,Y" names="Fire,Formation,-,-,-,-,Start,Coin,Service,Test,Pause"/>
  <switches default="FF FD">
