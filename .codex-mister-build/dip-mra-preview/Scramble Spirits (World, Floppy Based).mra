    <dip bits="9" name="SW2:2 Demo Sounds" ids="On,Off"/>
    <dip bits="10" name="SW2:3 Lives 1/2" ids="On,Off"/>
    <dip bits="11" name="SW2:4 Lives 2/2" ids="On,Off"/>
    <dip bits="12" name="SW2:5 Bonus Life 1/2" ids="On,Off"/>
    <dip bits="13" name="SW2:6 Bonus Life 2/2" ids="On,Off"/>
    <dip bits="14" name="SW2:7 Difficulty 1/2" ids="On,Off"/>
    <dip bits="15" name="SW2:8 Difficulty 2/2" ids="On,Off"/>
  </switches>
  <rom index="1" zip="sspirits.zip" md5="none">
