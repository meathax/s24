# Local MRA staging/regeneration output (tools/gen_mra.py --out-dir default).
# Curated release MRAs -- the ones actually meant to be published -- live in
# /releases/ instead and are tracked normally.
/mra/

# Keep the six curated parent MRAs visible to Git. Clone experiments and local
# generator output remain ignored here and under mra/ above.
/releases/*.mra
!/releases/Bonanza Bros.mra
!/releases/Crack Down.mra
!/releases/Gain Ground.mra
!/releases/Hot Rod (World, 3 Players, Turbo).mra
!/releases/Rough Racer.mra
!/releases/Scramble Spirits.mra
